## Служебные файлы tests/ — не тесты.
const NOT_TESTS := ["test_base", "runner", "catalog", "shots", "perf", "dungeon_shots"]


static func has(test_id: String) -> bool:
	return TESTS.has(test_id)


## Группа теста ("" — теста нет в каталоге).
static func group_of(test_id: String) -> String:
	return String((TESTS[test_id] as Array)[0]) if TESTS.has(test_id) else ""


## Название группы.
static func group_name(group_id: String) -> String:
	for g in GROUPS:
		if String(g[0]) == group_id:
			return String(g[1])
	return group_id


## О чём группа.
static func group_about(group_id: String) -> String:
	for g in GROUPS:
		if String(g[0]) == group_id:
			return String(g[2])
	return ""


static func group_ids() -> PackedStringArray:
	var res := PackedStringArray()
	for g in GROUPS:
		res.append(String(g[0]))
	return res


## Короткое название теста (нет в каталоге — id).
static func title(test_id: String) -> String:
	return String((TESTS[test_id] as Array)[1]) if TESTS.has(test_id) else test_id


## Что проверяет.
static func what(test_id: String) -> String:
	return String((TESTS[test_id] as Array)[2]) if TESTS.has(test_id) else ""


static func flags(test_id: String) -> Array:
	return (TESTS[test_id] as Array)[3] if TESTS.has(test_id) else []


## Время в CI, с (оценка; нет в каталоге — 5).
static func secs(test_id: String) -> float:
	return float((TESTS[test_id] as Array)[4]) if TESTS.has(test_id) else 5.0


## В «Автотестах: быстрых» на телефоне.
static func is_quick(test_id: String) -> bool:
	return flags(test_id).has("quick")


## Проверяет модели из пакета ресурсов (без всех частей — пропуск).
static func needs_pack(test_id: String) -> bool:
	return flags(test_id).has("pack")


## Причина «только CI» ("" — идёт и на телефоне).
static func ci_only(test_id: String) -> String:
	for f in flags(test_id):
		if String(f).begins_with("ci:"):
			return String(f).substr(3)
	return ""


## Тесты группы по порядку каталога.
static func in_group(group_id: String) -> PackedStringArray:
	var res := PackedStringArray()
	for k in TESTS:
		if group_of(String(k)) == group_id:
			res.append(String(k))
	return res


## Быстрые тесты по порядку каталога.
static func quick() -> PackedStringArray:
	var res := PackedStringArray()
	for k in TESTS:
		if is_quick(String(k)):
			res.append(String(k))
	return res


## Строка теста для отчёта: «Название (группа)».
static func label(test_id: String) -> String:
	if not TESTS.has(test_id):
		return test_id
	return "%s (%s)" % [title(test_id), group_name(group_of(test_id))]
