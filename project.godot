; Engine configuration file.
config_version=5

[application]

config/name="Dark Pact"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/MyRappelz"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.07, 0.1, 1)
boot_splash/image="res://assets/art/logo_dark_pact.png"
boot_splash/fullsize=false
config/icon="res://assets/branding/icon.png"
config/project_settings_override="user://renderer_override.cfg"

[autoload]

Game="*res://game_state.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/myrappelz_download/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

atmo_night={
"type": "float",
"value": 0.0
}
atmo_wet={
"type": "float",
"value": 0.0
}
atmo_rain={
"type": "float",
"value": 0.0
}
atmo_flash={
"type": "float",
"value": 0.0
}
atmo_fog={
"type": "float",
"value": 0.0
}
atmo_sun_dir={
"type": "vec3",
"value": Vector3(0.35, 0.82, 0.45)
}
atmo_sun_color={
"type": "color",
"value": Color(0.85, 0.8, 0.71, 1)
}
atmo_sky_color={
"type": "color",
"value": Color(0.74, 0.86, 1, 1)
}
