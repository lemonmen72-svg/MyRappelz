## Дополнительные задания (тесты, будущие события): id → задание в том же формате, что QUESTS.
static var extra: Dictionary = {}
## Сдвиг часов суточных заданий, с (тесты: «прошли сутки»).
static var time_shift := 0.0


static func get_quest(id: String) -> Dictionary:
	if QUESTS.has(id):
		return QUESTS[id]
	return extra.get(id, {})


static func has_quest(id: String) -> bool:
	return QUESTS.has(id) or extra.has(id)


## Все id заданий по порядку (сначала QUESTS, потом extra).
static func all_ids() -> Array:
	var res: Array = QUESTS.keys()
	for k in extra:
		if not res.has(k):
			res.append(k)
	return res


## Настоящее время для суточных заданий, с (Unix; + time_shift).
static func now() -> float:
	return Time.get_unix_time_from_system() + time_shift


## Перезарядка повторяемого задания, с (0 — без неё).
static func cooldown(id: String) -> float:
	return float(get_quest(id).get("cooldown", 0))


## Текст задания field ("name", "desc", "offer", "progress", "done"): свой для расы героя (by_race) или общий.
static func text(id: String, field: String) -> String:
	var q := get_quest(id)
	var by: Variant = q.get("by_race", null)
	if by is Dictionary and (by as Dictionary).has(Game.race_id):
		var r: Dictionary = (by as Dictionary)[Game.race_id]
		if r.has(field):
			return String(r[field])
	return String(q.get(field, ""))


static func quest_name(id: String) -> String:
	var t := text(id, "name")
	return t if t != "" else id


## Кто это для героя: "@elder" — староста деревни его расы, иначе как есть.
static func resolve_npc(npc: String) -> String:
	if npc == "@elder":
		return String(ELDERS.get(Game.race_id, "elder_human"))
	return npc


static func giver(id: String) -> String:
	return resolve_npc(String(get_quest(id).get("giver", "")))


static func turn_in(id: String) -> String:
	var q := get_quest(id)
	return resolve_npc(String(q.get("turn_in", q.get("giver", ""))))


## Какие задания нужно сдать раньше (prev: строка или массив; [] — никакие).
static func prereqs(id: String) -> Array:
	var p: Variant = get_quest(id).get("prev", "")
	var res: Array = []
	if p is Array:
		for e in p:
			if String(e) != "":
				res.append(String(e))
	elif String(p) != "":
		res.append(String(p))
	return res


## Уровень, под который подобран опыт награды (xp_level или level; у заказов gen — уровень героя).
static func xp_level(id: String) -> int:
	var q := get_quest(id)
	var lvl := int(q.get("xp_level", q.get("level", 1)))
	if q.has("gen"):
		lvl = maxi(lvl, Game.level)
	return lvl


## Цели задания: у взятого задания со своими целями (заказ gen) — из его записи, иначе из данных.
static func goals(id: String) -> Array:
	var rec: Variant = Game.quests_active.get(id)
	if rec is Dictionary and (rec as Dictionary).get("goals") is Array:
		return (rec as Dictionary)["goals"]
	return get_quest(id).get("goals", [])


## Награда задания (предметы-заготовки уже по герою — resolve_item): у взятого заказа — из его записи; у сданного
## раньше повторяемого — repeat_rewards (если есть); заказ, который ещё не взят, — опыт и золото по уровню героя.
static func rewards(id: String) -> Dictionary:
	var q := get_quest(id)
	var src: Dictionary = q.get("rewards", {})
	var rec: Variant = Game.quests_active.get(id)
	if rec is Dictionary and (rec as Dictionary).get("rewards") is Dictionary:
		src = (rec as Dictionary)["rewards"]
	elif q.has("gen"):
		src = contract_rewards(maxi(int(q.get("level", 1)), Game.level))
	elif int(Game.quests_done.get(id, 0)) > 0 and q.get("repeat_rewards") is Dictionary:
		src = q["repeat_rewards"]
	var res: Dictionary = src.duplicate()
	var items: Dictionary = {}
	var raw: Variant = src.get("items", {})
	if raw is Dictionary:
		for k in raw:
			var it := resolve_item(String(k))
			if it != "":
				items[it] = int(items.get(it, 0)) + int((raw as Dictionary)[k])
	res["items"] = items
	return res


## Предметы награды {id: количество}.
static func reward_items(id: String) -> Dictionary:
	return rewards(id).get("items", {})


## Предмет награды по герою: "@body_r<N>" — доспех варианта профессии (Бродяге — охотничий), "@weapon_r<N>" —
## оружие ранга N, подходящее профессии (вид — как у надетого, если такой есть); остальное — как есть.
static func resolve_item(token: String) -> String:
	if not token.begins_with("@"):
		return token
	var i := token.rfind("_r")
	var rank_n := int(token.substr(i + 2)) if i > 0 else 1
	if token.begins_with("@body"):
		var v := ItemData.body_armor_for(Game.class_id)
		if v == "":
			v = "hunter"
		return "armor_body_%s_r%d" % [v, rank_n]
	if token.begins_with("@weapon"):
		var fit: Array = []
		for w in LootTable.weapons_of_rank(rank_n):
			var wid := String(w)
			if ItemData.rank(wid) == rank_n and ItemData.weapon_fits(wid, Game.class_id) and not ItemData.is_shield(wid):
				fit.append(wid)
		if fit.is_empty():
			return ""
		var kind := ItemData.weapon_kind(Game.weapon) if Game.weapon != "" else ""
		for w in fit:
			if ItemData.weapon_kind(String(w)) == kind:
				return String(w)
		return String(fit[0])
	return ""


static func is_state_goal(g: Dictionary) -> bool:
	return STATE_GOALS.has(String(g.get("type", "")))


## С кем поговорить для цели "talk": "@elder" — староста деревни расы героя.
static func goal_npc(g: Dictionary) -> String:
	return resolve_npc(String(g.get("npc", "")))


## Сколько нужно для цели (у "level" — уровень).
static func goal_need(g: Dictionary) -> int:
	return maxi(1, int(g.get("n", 1)))


## Виды зверей цели kill: targets или target ([] — любые).
static func goal_species(g: Dictionary) -> Array:
	var res: Array = []
	var arr: Variant = g.get("targets", null)
	if arr is Array:
		for e in arr:
			if String(e) != "":
				res.append(String(e))
	var t := String(g.get("target", ""))
	if t != "" and not res.has(t):
		res.append(t)
	return res


## Подпись ячейки снаряжения ("ring1|ring2" — «кольцо»).
static func slot_name(slot: String) -> String:
	if slot.contains("|"):
		slot = slot.get_slice("|", 0)
	if SLOT_NAMES.has(slot):
		return String(SLOT_NAMES[slot])
	for e in ItemData.GEAR_SLOTS:
		if String(e[0]) == slot:
			return String(ItemData.GEAR_KIND_NAMES.get(String(e[2]), String(e[1])))
	return slot


## Подпись цели: своя (text) или по виду цели.
static func goal_text(g: Dictionary) -> String:
	if g.has("text"):
		return String(g["text"])
	var names_sp: Array = []
	for sp in goal_species(g):
		if MobData.TYPES.has(String(sp)):
			names_sp.append(String(MobData.get_type(String(sp))["name"]))
	var who := " / ".join(PackedStringArray(names_sp))
	var items: Array = g.get("items", [])
	var names: Array = []
	for it in items:
		names.append(ItemData.item_name(String(it)))
	var what := " / ".join(PackedStringArray(names))
	var npc := String(g.get("npc", ""))
	var slots: Array = []
	for s in g.get("slots", []):
		slots.append(slot_name(String(s)))
	var where := ", ".join(PackedStringArray(slots))
	match String(g.get("type", "")):
		"kill":
			return "Победить зверей" + (": " + who if who != "" else "")
		"tame":
			return "Поймать душу в карту" + (": " + who if who != "" else "")
		"form":
			return "Сформировать существо" + (": " + who if who != "" else "")
		"summon":
			return "Призвать питомца" + (": " + who if who != "" else "")
		"pet_kill":
			return "Победить зверей вместе с питомцем" + (": " + who if who != "" else "")
		"buy":
			return ("Купить: " + what if what != "" else "Купить вещи") + (" у " + NpcData.name_gen(npc) if npc != "" else "")
		"sell":
			return ("Продать: " + what if what != "" else "Продать вещи") + (" " + NpcData.name_dat(npc) if npc != "" else "")
		"use":
			return "Использовать: " + what if what != "" else "Использовать предмет"
		"store":
			return "Положить на склад: " + what if what != "" else "Положить вещь на склад"
		"collect":
			return "Собрать: " + what
		"level":
			return "Достичь %d уровня" % goal_need(g)
		"skill":
			return "Изучить умение профессии"
		"talk":
			return "Поговорить: " + NpcData.npc_name(goal_npc(g))
		"equip":
			return "Надеть: " + where if where != "" else "Надеть снаряжение"
		"upgrade":
			var what_up: String = where if where != "" else String({"weapon": "оружие", "armor": "броню"}.get(
				String(g.get("what", "")), "вещь"))
			return "Заточить до +%d: %s" % [int(g.get("plus", 1)), what_up]
		"pet_skill":
			return "Изучить умения питомцу"
		"pet_gear":
			return "Надеть вещь питомцу"
		"gather":
			return "Собрать с земли: " + what
		"quest":
			return "Выполнить задание «%s»" % quest_name(String(g.get("id", "")))
		"enter":
			return "Спуститься в подземелье" if String(g.get("location", "dungeon")) == "dungeon" else "Вернуться на остров"
	return String(g.get("type", "?"))


## Награда одной строкой: «15 оп., 10 зол., Зеркальная карта ×1, 5 JP».
static func reward_text(id: String) -> String:
	return rewards_line(rewards(id))


## Награда (словарь rewards) одной строкой.
static func rewards_line(r: Dictionary) -> String:
	var parts: Array = []
	if int(r.get("xp", 0)) > 0:
		parts.append("%d оп." % int(r["xp"]))
	if int(r.get("gold", 0)) > 0:
		parts.append("%d зол." % int(r["gold"]))
	var items: Dictionary = r.get("items", {})
	for k in items:
		parts.append("%s ×%d" % [ItemData.item_name(String(k)), int(items[k])])
	if int(r.get("jp", 0)) > 0:
		parts.append("%d JP" % int(r["jp"]))
	return ", ".join(PackedStringArray(parts))


# ---------- Заказ писаря (gen "scribe") ----------

## Опыт и золото заказа герою уровня level (предметы бросаются при взятии — contract).
static func contract_rewards(level: int) -> Dictionary:
	var l := maxi(1, level)
	return {"xp": int(round(MobStats.xp_to_next(l) * CONTRACT_XP)), "gold": CONTRACT_GOLD * l}


## Заказ писаря для героя уровня level: {"goals": [цель], "rewards": {...}}. Половина заказов — победить
## CONTRACT_KILLS зверей своего уровня ± CONTRACT_SPREAD, половина — принести CONTRACT_ITEMS трофеев вида, что водится
## на острове в этих уровнях (квестовая добыча с этого вида). zones — mob_zones острова ([] — по базовым уровням
## видов MobData). rng — свой генератор (тесты).
static func contract(level: int, zones: Array, rng: RandomNumberGenerator = null) -> Dictionary:
	var r := rng
	if r == null:
		r = RandomNumberGenerator.new()
		r.randomize()
	var lo := clampi(level - CONTRACT_SPREAD, 1, 30 - 2 * CONTRACT_SPREAD)
	var hi := maxi(lo + 2 * CONTRACT_SPREAD, level + CONTRACT_SPREAD)
	var cands := contract_species(lo, hi, zones)
	var goal: Dictionary
	if cands.is_empty() or r.randf() < 0.5:
		goal = {"type": "kill", "target": "", "min_level": lo, "max_level": hi, "n": CONTRACT_KILLS,
			"text": "Победить зверей %d–%d уровня" % [lo, hi]}
	else:
		var c: Array = cands[r.randi() % cands.size()]
		var sp := String(c[0])
		var item := String(c[1])
		goal = {"type": "collect", "items": [item], "n": CONTRACT_ITEMS, "take": true, "drop_from": sp,
			"text": "Принести: %s (%s)" % [ItemData.item_name(item), String(MobData.get_type(sp)["name"])]}
	var rw := contract_rewards(level)
	var items: Dictionary = {ItemData.potion_id("hp", ItemData.potion_rank_for_level(level)): 3}
	if r.randf() < CONTRACT_CUBE:
		var kind := "attack" if r.randf() < 0.5 else "defense"
		items[ItemData.cube_id(kind, ItemData.cube_rank_for_level(level))] = 1
	rw["items"] = items
	return {"goals": [goal], "rewards": rw}


## Виды для заказа «принеси трофеи»: [[вид, трофей], …] — обычные звери (не боссы) острова, чьи уровни
## пересекаются с lo…hi и у кого есть трофей.
static func contract_species(lo: int, hi: int, zones: Array) -> Array:
	var res: Array = []
	var seen: Dictionary = {}
	if zones.is_empty():
		for k in MobData.TYPES:
			var sp := String(k)
			var bl := int(MobData.get_type(sp).get("level", 1))
			if bl >= lo and bl <= hi:
				_contract_add(res, seen, sp)
		return res
	for z in zones:
		var zd: Dictionary = z
		var zl: Array = zd.get("levels", [1, 1])
		for e in zd.get("mobs", []):
			var a: Array = e
			var sp := String(a[0])
			var s_lo := int(a[2]) if a.size() >= 4 else int(zl[0])
			var s_hi := int(a[3]) if a.size() >= 4 else int(zl[1])
			if s_hi >= lo and s_lo <= hi:
				_contract_add(res, seen, sp)
	return res


static func _contract_add(res: Array, seen: Dictionary, sp: String) -> void:
	if seen.has(sp) or not MobData.TYPES.has(sp) or MobData.is_boss(sp) or MobData.is_mini_boss(sp):
		return
	var mats := MobData.materials(sp)
	if mats.is_empty():
		return
	seen[sp] = true
	res.append([sp, String(mats[0])])
