	return NPCS.get(id, {})


static func has_npc(id: String) -> bool:
	return NPCS.has(id)


## Имя NPC («Учитель Кирк»); неизвестный — его id.
static func npc_name(id: String) -> String:
	return String(npc(id).get("name", id))


## Родительный падеж: «у Учителя Кирка».
static func name_gen(id: String) -> String:
	return String(npc(id).get("gen", npc_name(id)))


## Дательный падеж: «вернитесь к Учителю Кирку».
static func name_dat(id: String) -> String:
	return String(npc(id).get("dat", npc_name(id)))


## Товары NPC (id предметов), [] — не торгует.
static func shop(id: String) -> Array:
	return npc(id).get("shop", [])


static func is_trader(id: String) -> bool:
	return not shop(id).is_empty()


## Можно ли с NPC говорить (кнопка «Говорить», окно диалога).
static func has_dialog(id: String) -> bool:
	return bool(npc(id).get("dialog", false))


## Заголовок окна торговли.
static func shop_title(id: String) -> String:
	return String(npc(id).get("shop_title", npc_name(id)))


## Кто продаёт предмет: id NPC по порядку NPCS.
static func sellers_of(item_id: String) -> Array:
	var res: Array = []
	for k in NPCS:
		if shop(String(k)).has(item_id):
			res.append(String(k))
	return res


## Реплика приветствия: kind — "ready" | "offer" | "busy" | "wait" | "young" | "veteran" | "kin" | "full_bag" |
## "idle" (нет своей — "idle").
static func greet(id: String, kind: String) -> String:
	var g: Dictionary = npc(id).get("greet", {})
	return String(g.get(kind, g.get("idle", "")))


## Есть ли у NPC своя реплика вида kind.
static func has_greet(id: String, kind: String) -> bool:
	var g: Dictionary = npc(id).get("greet", {})
	return g.has(kind)


## Реплика на странице «Задания», когда поручений нет.
static func no_quests(id: String) -> String:
	return String(npc(id).get("no_quests", NO_QUESTS))


## NPC, которых Npcs ставит по полю spot (все, кроме торговца и Учителя Кирка), по порядку NPCS.
static func placed_ids() -> Array:
	var res: Array = []
	for k in NPCS:
		if npc(String(k)).has("spot"):
			res.append(String(k))
	return res


## Где стоит NPC (поле spot; {} — ставится отдельно).
static func spot(id: String) -> Dictionary:
	return npc(id).get("spot", {})


## Пункты диалога о делах NPC (поле talk).
static func talk_options(id: String) -> Array:
	return npc(id).get("talk", [])


## Пункт диалога по пути "guide" или "guide/pets" ({} — нет такого).
static func talk_entry(id: String, path: String) -> Dictionary:
	var list: Array = talk_options(id)
	var found: Dictionary = {}
	for part in path.split("/"):
		found = {}
		for e in list:
			var d: Dictionary = e
			if String(d.get("id", "")) == part:
				found = d
				break
		if found.is_empty():
			return {}
		list = found.get("topics", [])
	return found


## Подпись пункта диалога: у дел, которые появятся позже, — «— скоро».
static func talk_label(entry: Dictionary) -> String:
	var t := String(entry.get("label", ""))
	if bool(entry.get("soon", false)):
		t += " — скоро"
	return t
